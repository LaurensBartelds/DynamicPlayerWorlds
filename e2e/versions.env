# Pinned coordinates for the e2e compose harness (F11). Bump deliberately with
# paperApi / velocityApi / TestDatabase / TestObjectStore — never float.
#
# Sourced by e2e/scripts/*.sh. Values must match gradle/libs.versions.toml and
# the testing fixtures unless a smoke is intentionally exercising a skew.

PAPER_MC_VERSION=26.2
PAPER_BUILD=112
# fill.papermc.io object for paper-26.2-112.jar (server:default)
PAPER_SERVER_URL=https://fill-data.papermc.io/v1/objects/bd3a58cf96874e5ea6643f5f6fe9b4f5bf9e34b795fa078c2f0ee8b98b2f907e/paper-26.2-112.jar
PAPER_SERVER_SHA256=bd3a58cf96874e5ea6643f5f6fe9b4f5bf9e34b795fa078c2f0ee8b98b2f907e

VELOCITY_VERSION=4.0.0
VELOCITY_BUILD=6
VELOCITY_SERVER_URL=https://fill-data.papermc.io/v1/objects/4540289f48c83e305fc2f2c495a84d1f4d0b7f360830251e169dd5a208740e70/velocity-4.0.0-6.jar
VELOCITY_SERVER_SHA256=4540289f48c83e305fc2f2c495a84d1f4d0b7f360830251e169dd5a208740e70

# Client bot: minecraft-data schemas through 26.1 (protocol 775). Paper is 26.2
# (protocol 776). The bot advertises 776 on the handshake while decoding with
# 26.1 schemas — adjacent releases, enough for a join smoke (see e2e/bot).
E2E_BOT_MC_VERSION=26.1
E2E_BOT_PROTOCOL_VERSION=776
E2E_BOT_USERNAME=E2EPlayer

POSTGRES_IMAGE=postgres:18.3
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-04-16T18-13-26Z
JAVA_IMAGE=eclipse-temurin:25-jre

# Shared secrets for the harness only — never production values.
E2E_FORWARDING_SECRET=e2e-forwarding-secret-not-for-prod
E2E_RCON_PASSWORD=e2e-rcon-not-for-prod
E2E_POSTGRES_PASSWORD=e2e-postgres-not-for-prod
E2E_MINIO_USER=gzmn-e2e
E2E_MINIO_PASSWORD=gzmn-e2e-secret
E2E_MINIO_BUCKET=gzmn-worlds

E2E_DB_HOST=127.0.0.1
E2E_DB_PORT=5432
E2E_DB_USER=gzmn
E2E_DB_PASSWORD=e2e-postgres-not-for-prod
E2E_DB_NAME=gzmn_worlds

E2E_S3_ENDPOINT=http://127.0.0.1:9000
E2E_S3_REGION=us-east-1
E2E_S3_ACCESS_KEY=gzmn-e2e
E2E_S3_SECRET_KEY=gzmn-e2e-secret
E2E_S3_BUCKET=gzmn-worlds
