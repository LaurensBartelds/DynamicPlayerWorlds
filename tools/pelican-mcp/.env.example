# Pelican Panel Configuration
# 1. Base URL of your Pelican Panel (without trailing slash)
PELICAN_URL=https://panel.example.com

# 2. Pelican Client API Key (create one in: Account Settings -> API Credentials)
PELICAN_API_KEY=pelican_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3. Server Identifiers (short ID from URL or server UUID)
PAPER_SERVER_ID=
PROXY_SERVER_ID=
DEFAULT_SERVER_ID=
