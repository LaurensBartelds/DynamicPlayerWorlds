root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{kt,kts}]
indent_size = 4

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
indent_size = 2
# Markdown uses trailing double-space for hard line breaks.
trim_trailing_whitespace = false
max_line_length = 80

[*.sql]
indent_size = 2

[Makefile]
indent_style = tab

[gradlew]
indent_style = tab
